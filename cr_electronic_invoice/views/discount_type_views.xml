<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_discount_type_form" model="ir.ui.view">
        <field name="name">discount.type.form</field>
        <field name="model">discount.type</field>
        <field name="arch" type="xml">
            <form string="Discount type">
                <sheet string="Discount type">
                    <group col="4">
                        <field name="code"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_discount_type_tree" model="ir.ui.view">
        <field name="name">discount.type.tree</field>
        <field name="model">discount.type</field>
        <field name="arch" type="xml">
            <tree string="Discount type" editable="bottom">
                <field name="code"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_discount_type" model="ir.actions.act_window">
        <field name="name">Discount type</field>
        <field name="res_model">discount.type</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
